        "--flavor",
        "dev"
      ]
    },
    {
      "name": "App Prod",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/app",
      "program": "lib/main.dart",
      "args": [
        "--flavor",
        "prod"
      ]
    }
  ]
