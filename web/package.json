{
  "name": "starter-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:local": "vite --mode localdev --host 127.0.0.1 --port 5173 --strictPort",
    "dev:development": "vite --mode development",
    "build:local": "yarn typecheck && vite build --mode localdev",
    "build:development": "yarn typecheck && vite build --mode development",
    "build:production": "yarn typecheck && vite build --mode production",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@nuxt/ui": "4.11.3",
    "@supabase/supabase-js": "2.117.2",
    "tailwindcss": "4",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.8",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vue-tsc": "3.3.13"
  }
}
